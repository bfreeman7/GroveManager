# Copy to /etc/orchardmonitor.env and set values
# Then add to orchardmonitor.service [Service]: EnvironmentFile=/etc/orchardmonitor.env

DATA_STORAGE_PATH=/home/bfree/Repos/OrchardMonitor/data
OPENSPRINKLER_URL=http://192.168.1.x:8080
OPENSPRINKLER_PASSWORD=opendoor

# Sift forwarding (ecowitt + irrigation channels)
# SIFT_MODE=fake
# SIFT_ASSET=orchard-main
# FORWARD_INTERVAL_SECONDS=30
# FORWARD_STALE_SECONDS=1800          # /health → degraded after this with pending+failures
# FORWARD_RESTART_AFTER_SECONDS=3600  # process exit so systemd restarts (clear stuck gRPC/DNS)
# FORWARD_WATCHDOG_ENABLED=1
# FORWARD_CONNECTIVITY_PROBE=1        # skip gRPC while DNS/offline; retry immediately on restore
# FORWARD_CONNECTIVITY_PROBE_TIMEOUT_SECONDS=3
# FORWARD_ERROR_LOG_INTERVAL_SECONDS=300
# FORWARD_BACKOFF_MAX_SECONDS=300

# Irrigation → Sift sync (requires OPENSPRINKLER_URL + password)
# IRRIGATION_SYNC_ENABLED=1
# IRRIGATION_SYNC_INTERVAL_SECONDS=15
# IRRIGATION_HISTORY_SYNC_INTERVAL_SECONDS=300
# IRRIGATION_HISTORY_LOOKBACK_MINUTES=5
# IRRIGATION_HISTORY_STARTUP_LOOKBACK_HOURS=24
